{
  "uid": "blueapi",
  "title": "BlueAPI",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instrument",
        "label": "Instrument",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info, service_instrument)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "links": [
    {
      "title": "Traces (Jaeger)",
      "url": "http://localhost:16686",
      "type": "link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Tasks run",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(blueapi_task_duration_seconds_count{service_instrument=~\"$instrument\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Since the worker process started"
    },
    {
      "id": 2,
      "title": "Success rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(blueapi_task_duration_seconds_count{outcome=\"success\",service_instrument=~\"$instrument\"}) / sum(blueapi_task_duration_seconds_count{service_instrument=~\"$instrument\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Since the worker process started"
    },
    {
      "id": 3,
      "title": "Runs by plan and outcome",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name, outcome) (blueapi_task_duration_seconds_count{service_instrument=~\"$instrument\"})",
          "legendFormat": "{{task_name}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "description": "Since the worker process started"
    },
    {
      "id": 4,
      "title": "Task rate by plan and outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name, outcome) (rate(blueapi_task_duration_seconds_count{service_instrument=~\"$instrument\"}[$__rate_interval]))",
          "legendFormat": "{{task_name}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Task duration by plan",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, task_name) (rate(blueapi_task_duration_seconds_bucket{service_instrument=~\"$instrument\"}[$__rate_interval])))",
          "legendFormat": "{{task_name}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, task_name) (rate(blueapi_task_duration_seconds_bucket{service_instrument=~\"$instrument\"}[$__rate_interval])))",
          "legendFormat": "{{task_name}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Estimated from histogram buckets, so only as precise as the bucket boundaries"
    },
    {
      "id": 6,
      "title": "Mean task duration by plan",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_name) (blueapi_task_duration_seconds_sum{service_instrument=~\"$instrument\"}) / sum by (task_name) (blueapi_task_duration_seconds_count{service_instrument=~\"$instrument\"})",
          "legendFormat": "{{task_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "description": "Since the worker process started"
    },
    {
      "id": 7,
      "title": "Requests in flight",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_active_requests{service_instrument=~\"$instrument\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "HTTP request rate by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_method, http_target, http_status_code) (rate(http_server_duration_milliseconds_count{service_instrument=~\"$instrument\"}[$__rate_interval]))",
          "legendFormat": "{{http_method}} {{http_target}} {{http_status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "HTTP p95 latency by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_method, http_target) (rate(http_server_duration_milliseconds_bucket{service_instrument=~\"$instrument\"}[$__rate_interval])))",
          "legendFormat": "{{http_method}} {{http_target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
