# Point blueapi's telemetry at the local monitoring stack (compose profile "monitoring")
export OTLP_EXPORT_ENABLED=true
# The collector, which forwards metrics to Prometheus and traces to Jaeger and Tempo
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Default is 60s, too slow to watch a demo
export OTEL_METRIC_EXPORT_INTERVAL=5000
export INSTRUMENT=adsim
